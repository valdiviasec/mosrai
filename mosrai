def cmd_init(args) -> int:
    root = Path(args.dir)
    root.mkdir(parents=True, exist_ok=True)
    for d in DIRS:
        (root / d).mkdir(exist_ok=True)

    state_file = root / 'engagement.state'
    if not state_file.exists():
        template = REPO / 'templates' / 'engagement-state.yaml'
        if template.is_file():
            state_file.write_text(template.read_text())
        else:
            state_file.write_text('app: {}\n')
        print(f'created {state_file}')

    ledger = root / 'LEDGER.md'
    if not ledger.exists():
        template = REPO / 'templates' / 'LEDGER.md'
        ledger.write_text(template.read_text() if template.is_file() else '# Retest Ledger\n')
        print(f'created {ledger}')

    fresh = load_state(state_file) is None
    existing_phase = None
    if state_file.is_file():
        m = re.search(r'^phase:\s*"?([^"\n#]*)"?', state_file.read_text(), re.M)
        if m:
            existing_phase = m.group(1).strip()

    updates = {
        'app_name': args.app or '',
        'package': args.package or '',
        'platform': args.platform or '',
        'stack': args.stack or '',
        'started': now_iso(),
        'updated': now_iso(),
    }
    for key, value in updates.items():
        if value:
            set_state_scalar(state_file, key, value)
    if fresh or not existing_phase or existing_phase == '""':
        set_state_scalar(state_file, 'phase', 'intake')

    if args.heavy or args.soft:
        state_text = state_file.read_text()
        if args.heavy:
            state_text = re.sub(r'^(\s*heavy:).*$', rf'\1 "{args.heavy}"', state_text, flags=re.M)
        if args.soft:
            state_text = re.sub(r'^(\s*soft:).*$', rf'\1 "{args.soft}"', state_text, flags=re.M)
        state_file.write_text(state_text)
    if args.intake_tier:
        state_text = state_file.read_text()
        state_text = re.sub(r'^(\s*intake_tier:).*$', rf'\1 "{args.intake_tier}"', state_text, flags=re.M)
        state_file.write_text(state_text)

    if args.artifact:
        artifact = Path(args.artifact)
        if not artifact.is_file():
            return fail(f'artifact not found: {artifact}')
        digest = sha256_file(artifact)
        intake_dir = root / 'intake'
        intake_dir.mkdir(exist_ok=True)
        dest = intake_dir / artifact.name
        shutil.copy2(artifact, dest)
        print(f'artifact: {dest}')
        print(f'artifact sha256: {digest}')
        set_state_scalar(state_file, 'artifact_sha256', digest)
        if args.platform == '' and artifact.suffix.lower() in ('.apk', '.ipa'):
            set_state_scalar(state_file, 'platform',
                             'android' if artifact.suffix.lower() == '.apk' else 'ios')

    print(f'engagement ready: {root}')
    missing = [d for d in DIRS if not (root / d).is_dir()]
    if missing:
        print(f'warning: missing dirs: {missing}')
    return 0


def cmd_status(args) -> int:
    root = Path(args.dir)
    state_file = root / 'engagement.state'
    state = load_state(state_file) if state_file.is_file() else {}
    findings = list((root / 'findings').glob('FIND-*.md')) if (root / 'findings').is_dir() else []
    journal = list((root / 'journal').glob('*.md')) if (root / 'journal').is_dir() else []
    chains = list((root / 'chains').glob('CHAIN-*.md')) if (root / 'chains').is_dir() else []
    rounds = sorted((root / 'retest').glob('round-*')) if (root / 'retest').is_dir() else []

    print(f'=== MOSRAI engagement: {root.name} ===')
    for key in ('app_name', 'package', 'platform', 'stack', 'phase',
                'heavy', 'soft', 'intake_tier', 'artifact_sha256'):
        value = state.get(key)
        if value:
            print(f'{key:16} {value}')
    print(f'{"findings":16} {len(findings)}')
    print(f'{"journal entries":16} {len(journal)}')
    print(f'{"chains":16} {len(chains)}')
    print(f'{"retest rounds":16} {len(rounds)}')

    gaps = []
    phase = state.get('phase', 'init')
    if not state.get('heavy') and not state.get('soft'):
        gaps.append('models not declared (cycle Step 2)')
    if state.get('intake_tier') == 'white-box' and not (root / 'context-pack.md').is_file():
        gaps.append('white-box intake without context-pack.md (cycle Step 3)')
    if phase in ('review', 'chain') and not journal:
        gaps.append('no operator journal entries before chain phase (cycle Steps 6-7)')
    if phase == 'chain' and not chains:
        gaps.append('phase=chain but no chain files (cycle Step 8)')
    if any(v in ('PERSISTS', 'PARTIAL', 'PENDING') for f in findings
           for v in [f.read_text()]) and not rounds:
        gaps.append('open verdicts without a retest round (cycle Step 9)')
    if gaps:
        print('gaps:')
        for g in gaps:
            print(f'  - {g}')
    else:
        print('gaps: none')
    return 0


def cmd_journal(args) -> int:
    root = Path(args.dir)
    jdir = root / 'journal'
    if not root.is_dir():
        return fail(f'engagement dir not found: {root}')
    jdir.mkdir(exist_ok=True)
    n = next_number('journal', jdir, r'^\d{4}-\d{2}-\d{2}-(\d{3})\.md$')
    entry_id = f'{today()}-{n:03d}'
    target = jdir / f'{entry_id}.md'

    template = REPO / 'templates' / 'operator-journal.md'
    body = template.read_text() if template.is_file() else '# Operator Journal\n'
    body = body.replace('{YYYY-MM-DD}-{NNN}', entry_id)
    body = body.replace('{ISO 8601}', now_iso())
    if args.finding:
        body = body.replace('{FIND-NNN, or "none yet"}', args.finding)
    if args.phase:
        body = body.replace('{enabling / recon / traffic / hunting / chain / retest}', args.phase)
    if args.title:
        body = body.replace('# Operator Journal', f'# {args.title}', 1)
    body = body.replace(
        '{1-7, see below}',
        f'{args.category}: {MAP_CATEGORIES.get(args.category, "?")}',
    )
    target.write_text(body)

    state_file = root / 'engagement.state'
    if state_file.is_file():
        text = state_file.read_text()
        if re.search(r'^journal:\s*$', text, re.M):
            text = re.sub(
                r'(^journal:\s*$\n(?:.*\n)*?\s*entries:\s*)\[\]',
                rf'\1\n    # - id: "{entry_id}"\n    #   finding: "{args.finding or ""}"\n    #   map_category: {args.category}\n    #   file: "journal/{entry_id}.md"',
                text, count=1, flags=re.M,
            )
        state_file.write_text(text)

