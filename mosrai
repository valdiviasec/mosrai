def main() -> int:
    parser = argparse.ArgumentParser(
        prog='mosrai',
        description='MOSRAI: Mobile Offensive Security Research AI Agent',
        add_help=True,
    )
    sub = parser.add_subparsers(dest='command')

    p = sub.add_parser('init', help='scaffold an engagement')
    p.add_argument('dir')
    p.add_argument('--app', default='')
    p.add_argument('--package', default='')
    p.add_argument('--platform', default='', choices=['', 'android', 'ios'])
    p.add_argument('--stack', default='')
    p.add_argument('--heavy', default='')
    p.add_argument('--soft', default='')
    p.add_argument('--intake-tier', dest='intake_tier', default='', choices=['', 'gray-box', 'white-box'])
    p.add_argument('--artifact', default='')
    p.set_defaults(func=cmd_init)

    p = sub.add_parser('start', help='launch the harness')
    p.add_argument('dir', nargs='?', default='.')
    p.set_defaults(func=cmd_start)

    p = sub.add_parser('status', help='engagement snapshot')
    p.add_argument('dir')
    p.set_defaults(func=cmd_status)

    p = sub.add_parser('report', help='consolidate and distribute')
    p.add_argument('dir', nargs='?', default='.')
    p.set_defaults(func=cmd_report)
    p = sub.add_parser('matrix', help='scaffold the attack surface matrix template')
    p.add_argument('dir', nargs='?', default='.')
    p.set_defaults(func=cmd_matrix)


    p = sub.add_parser('journal', help='log a human intervention')
    p.add_argument('dir')
    p.add_argument('--category', type=int, required=True, choices=list(MAP_CATEGORIES))
    p.add_argument('--finding', default='')
    p.add_argument('--phase', default='')
    p.add_argument('--title', default='')
    p.set_defaults(func=cmd_journal)

    p = sub.add_parser('chain', help='confirm a kill chain')
    p.add_argument('dir')
    p.add_argument('--title', default='')
    p.add_argument('--severity', default='')
    p.add_argument('--findings', default='')
    p.set_defaults(func=cmd_chain)

    p = sub.add_parser('retest', help='generate a retest checklist')
    p.add_argument('dir')
    p.add_argument('--round', type=int, required=True)
    p.add_argument('--artifact', default='')
    p.add_argument('--scope', default='all-open')
    p.set_defaults(func=cmd_checklist)

    p = sub.add_parser('ledger', help='record a verdict')
    p.add_argument('dir')
    p.add_argument('--finding', required=True)
    p.add_argument('--round', type=int, required=True)
    p.add_argument('--verdict', required=True)
    p.add_argument('--note', default='')
    p.add_argument('--sev', default='')
    p.add_argument('--maswe', default='')
    p.set_defaults(func=cmd_ledger)

    p = sub.add_parser('scrub', help='confidentiality gate')
    p.add_argument('target')
    p.add_argument('--conf', default=None)
    p.add_argument('--json', action='store_true', dest='json_output')
    p.add_argument('--strict', action='store_true')
    p.set_defaults(func=cmd_scrub)

    p = sub.add_parser('validate', help='self-test')
    p.add_argument('--json', action='store_true', dest='json_output')
    p.add_argument('--local', action='store_true')
    p.set_defaults(func=cmd_validate)

    p = sub.add_parser('lint', help='check skills')
    p.add_argument('--json', action='store_true', dest='json_output')
    p.add_argument('--fix', action='store_true')
    p.set_defaults(func=cmd_lint)

    p = sub.add_parser('index', help='rebuild SKILL_INDEX')
    p.set_defaults(func=cmd_index)

    p = sub.add_parser('new', help='scaffold a skill')
    p.add_argument('slug')
    p.set_defaults(func=cmd_new)

    args = parser.parse_args()
    if not getattr(args, 'command', None):
        print(_HELP_TEXT)
        return 1
    return args.func(args)


if __name__ == '__main__':
    sys.exit(main())
