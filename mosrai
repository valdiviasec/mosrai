def _parse_ledger_header(line):
    """Return (round_start_col, notes_col, n_cols) from a ledger header row."""
    if not line.startswith('|'):
        return None
    headers = [c.strip() for c in line.strip('|').split('|')]
    round_cols = [i for i, h in enumerate(headers) if re.fullmatch(r'R\d+', h)]
    if not round_cols:
        return None
    first_round = round_cols[0]
    notes_col = headers.index('Notes') if 'Notes' in headers else len(headers) - 1
    return first_round, notes_col, len(headers)


def _append_round_column(lines, header_idx, notes_col):
    """Extend a legacy header and its data rows with the next round column."""
    headers = [c.strip() for c in lines[header_idx].strip('|').split('|')]
    rounds = [int(h[1:]) for h in headers if re.fullmatch(r'R\d+', h)]
    new_round = max(rounds) + 1 if rounds else 1
    headers.insert(notes_col, f'R{new_round}')
    lines[header_idx] = '| ' + ' | '.join(headers) + ' |'
    if header_idx + 1 < len(lines) and re.fullmatch(r'\|[\s\-:|]+\|', lines[header_idx + 1]):
        sep = ['---'] * len(headers)
        lines[header_idx + 1] = '| ' + ' | '.join(sep) + ' |'
    for i in range(header_idx + 2, len(lines)):
        if not lines[i].startswith('|'):
            break
        cells = [c.strip() for c in lines[i].strip('|').split('|')]
        if len(cells) < len(headers):
            while len(cells) < len(headers) - 1:
                cells.insert(notes_col, '')
        lines[i] = '| ' + ' | '.join(cells) + ' |'
    return new_round


def cmd_ledger(args) -> int:
    root = Path(args.dir)
    ledger = root / 'LEDGER.md'
    if not ledger.is_file():
        return fail(f'LEDGER.md not found: {ledger}')

    normalized = args.verdict.strip().upper().replace('_', ' ')
    canonical = VERDICT_ALIASES.get(normalized) or VERDICTS_CANONICAL.get(normalized)
    if canonical is None:
        return fail(
            'invalid verdict {!r}; use one of: {}'.format(args.verdict, ', '.join(VERDICTS))
        )

    text = ledger.read_text()
    lines = text.splitlines()
    header_idx = None
    parsed = None
    for i, line in enumerate(lines):
        if line.startswith('| Finding') and 'R1' in line:
            parsed = _parse_ledger_header(line)
            if parsed:
                header_idx = i
                break
    if header_idx is None or parsed is None:
        return fail('LEDGER.md has no verdict table header')

    first_round_col, notes_col, n_cols = parsed

    round_numbers = [
        int(c) for c in
        [x.strip()[1:] for x in lines[header_idx].strip('|').split('|') if re.fullmatch(r'R\d+', x.strip())]
    ]
    if args.round not in round_numbers:
        while max(round_numbers, default=0) < args.round:
            new_round = _append_round_column(lines, header_idx, notes_col)
            round_numbers.append(new_round)
        first_round_col, notes_col, n_cols = _parse_ledger_header(lines[header_idx])

    finding = args.finding.upper()
    found = False
    for i in range(header_idx + 2, len(lines)):
        line = lines[i]
        if not line.startswith('|'):
            break
        cells = [c.strip() for c in line.strip('|').split('|')]
        if not cells or cells[0].upper() != finding:
            continue
        while len(cells) < n_cols:
            cells.insert(notes_col, '')
        if first_round_col >= 3:
            if args.sev and cells[1] in ('', '{sev}', '?'):
                cells[1] = args.sev
            if args.maswe and len(cells) > 2 and cells[2].startswith('{'):
                cells[2] = args.maswe
        round_col = round_numbers.index(args.round) + first_round_col
        cells[round_col] = canonical
        if args.note:
            cells[notes_col] = args.note
        lines[i] = '| ' + ' | '.join(cells) + ' |'
        found = True
        break
    if not found:
        cells = [finding, args.sev or '?', args.maswe or ''] if n_cols >= 3 else [finding, args.sev or '?']
        notes_placeholder = args.note or ''
        while len(cells) < n_cols:
            if len(cells) == n_cols - 1:
                cells.append(notes_placeholder)
            else:
                cells.append('')
        round_col = round_numbers.index(args.round) + first_round_col
        cells[round_col] = canonical
        insert_at = header_idx + 2
        while insert_at < len(lines) and lines[insert_at].startswith('|'):
            insert_at += 1
        lines.insert(insert_at, '| ' + ' | '.join(cells) + ' |')

    ledger.write_text('\n'.join(lines) + '\n')

    state_file = root / 'engagement.state'
    if state_file.is_file():
        state_text = state_file.read_text()
        state_text = re.sub(
            r'^(retest:\s*$\n(?:\s*.*\n)*?\s*current_round:\s*)\d+',
            rf'\g<1>{args.round}', state_text, count=1, flags=re.M,
        )
        set_state_scalar(state_file, 'updated', now_iso())
        state_file.write_text(state_text)

    print(f'{finding} round {args.round}: {canonical}')
    return 0


