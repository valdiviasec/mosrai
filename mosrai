def cmd_report(args) -> int:
    root = Path(args.dir)
    if not root.is_dir():
        return fail(f'engagement dir not found: {root}')

    allowlist = _load_allowlist()
    stats = {'suppressed': 0}
    results = scan_target(root, [], allowlist, stats)
    total = sum(len(v) for v in results.values())

    findings = list((root / 'findings').glob('FIND-*.md')) if (root / 'findings').is_dir() else []
    chains = list((root / 'chains').glob('CHAIN-*.md')) if (root / 'chains').is_dir() else []
    ledger_rows = 0
    ledger = root / 'LEDGER.md'
    if ledger.is_file():
        for line in ledger.read_text().splitlines():
            if line.startswith('| FIND-'):
                ledger_rows += 1

    if total == 0:
        print(f'scrub: PASS ({root})')
        print(f'findings: {len(findings)} | chains: {len(chains)} | ledger: {ledger_rows} rows')
        print('no redaction needed')
        return 0

    dist_dir = root / 'dist'
    dist_dir.mkdir(exist_ok=True)

    for name in ['findings', 'chains', 'journal']:
        src = root / name
        if src.is_dir():
            dest = dist_dir / name
            if dest.is_dir():
                shutil.rmtree(dest)
            shutil.copytree(src, dest)
    for name in ['LEDGER.md', 'context-pack.md']:
        src = root / name
        if src.is_file():
            shutil.copy2(src, dist_dir / name)

    for fpath in dist_dir.rglob('*'):
        if fpath.is_file() and not _is_binary(fpath):
            try:
                text = fpath.read_text(errors='replace')
                text = _redact_text(text)
                fpath.write_text(text)
            except OSError:
                pass

    stats2 = {'suppressed': 0}
    results2 = scan_target(dist_dir, [], allowlist, stats2)
    total2 = sum(len(v) for v in results2.values())

    if total2 == 0:
        print(f'scrub: FAIL ({root}) -> PASS (dist/)')
        print(f'findings: {len(findings)} | chains: {len(chains)} | ledger: {ledger_rows} rows')
        print(f'dist/ ready for distribution ({dist_dir})')
        return 0
    else:
        print(f'scrub: FAIL ({root}) -> FAIL (dist/): {total2} matches remain')
        print(f'findings: {len(findings)} | chains: {len(chains)} | ledger: {ledger_rows} rows')
        print(f'dist/ needs manual review ({dist_dir})')
        return 1


