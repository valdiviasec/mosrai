def _publishable_files():
    """Files git would ship (tracked + untracked, minus ignored)."""
    code, out, err = run(['git', 'ls-files', '-co', '--exclude-standard'])
    if code == 0 and out.strip():
        files = [REPO / line for line in out.splitlines() if line.strip()]
    else:
        files = [p for p in REPO.rglob('*') if p.is_file()]
    return [f for f in files if f.name != 'validation-report.md']


def _scrub_summary(out: str) -> str:
    for line in out.splitlines():
        if line.startswith('Result:'):
            return line.strip()
    return out.splitlines()[-1].strip() if out.splitlines() else 'no output'


def _lint_cmd():
    for p in [REPO / 'tools' / 'lint.py']:
        if p.is_file():
            return [PYTHON, str(p)]
    return None


def _index_cmd():
    for p in [REPO / 'tools' / 'build_index.py']:
        if p.is_file():
            return [PYTHON, str(p)]
    return None


