def _redact_text(text: str) -> str:
    text = RE_EMAIL.sub('<email>', text)
    text = _RE_BEARER.sub('<token>', text)
    text = _RE_REDACT_KEY.sub('<redacted>', text)

    def _ip_repl(m):
        if m.group() == '10.0.2.2':
            return m.group()
        return '<host_ip>'

    text = _RE_PRIVATE_IP.sub(_ip_repl, text)
    return text



